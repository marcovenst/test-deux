# Local dev; in production set to https://zenlakay.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
INGESTION_SHARED_SECRET="replace-with-a-strong-random-secret"
ADMIN_DASHBOARD_TOKEN="replace-with-admin-dashboard-token"

# Optional SEO (Google Search Console → HTML tag method)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-verification-token"
# NEXT_PUBLIC_TWITTER_SITE="@yourhandle"
# NEXT_PUBLIC_TWITTER_CREATOR="@yourhandle"

SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

APIFY_TOKEN="your-apify-token"
APIFY_ACTOR_ID="your-apify-actor-id"
APIFY_FACEBOOK_ACTOR_ID="your-apify-facebook-actor-id"
APIFY_INSTAGRAM_ACTOR_ID="your-apify-instagram-actor-id"
APIFY_TIKTOK_ACTOR_ID="your-apify-tiktok-actor-id"

REDDIT_CLIENT_ID="your-reddit-client-id"
REDDIT_CLIENT_SECRET="your-reddit-client-secret"
REDDIT_USER_AGENT="zen-rezo-a/1.0"

YOUTUBE_API_KEY="your-youtube-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

UPSTASH_QSTASH_TOKEN="your-upstash-qstash-token"

# Vercel Cron (optional): set in Vercel project env; Vercel sends Bearer CRON_SECRET on GET /api/jobs/pipeline
CRON_SECRET="generate-a-strong-random-secret"

# --- Stripe: self-serve sponsored placements (“Mete anons” checkout) ---
# Dashboard webhook: POST https://zenlakay.com/api/ads/self-serve/webhook → checkout.session.completed
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..." # signing secret for /api/ads/self-serve/webhook
STRIPE_BILLING_WEBHOOK_SECRET="whsec_..." # signing secret for /api/billing/webhook
STRIPE_SUBSCRIPTION_PRICE_ID="price_..."

RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="alerts@zenlakay.com"

TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM_NUMBER="+10000000000"

# --- Google AdSense (display ads) — setup order ---
#
# A) AdSense console: https://www.google.com/adsense/ — add zenlakay.com (or your domain), get approved.
# B) Ads → By ad unit → Display ads — create THREE units (e.g. “Feed top”, “Feed mid”, “Sidebar”).
#    Copy each unit’s slot id (digits only) into the three NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_* vars below.
# C) Account → Account settings — copy Publisher ID as ca-pub-XXXXXXXXXX into NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID.
# D) Turn ads on: NEXT_PUBLIC_ADS_ENABLED="true" and NEXT_PUBLIC_AD_PROVIDER="google"
# E) Deploy, then verify:
#    - https://YOURDOMAIN/ads.txt  (auto from client id unless ADS_TXT_CONTENT is set)
#    - Privacy policy: https://YOURDOMAIN/privacy (required for AdSense; link is in site footer)
# F) Optional overrides without redeploy: /admin/ads with ADMIN_DASHBOARD_TOKEN (see docs/ads-guide.md)

# --- Display ads (Google AdSense or direct sponsor banner) ---
# Set NEXT_PUBLIC_ADS_ENABLED="true" once AdSense slots exist (or for direct mode).
NEXT_PUBLIC_ADS_ENABLED="false"
NEXT_PUBLIC_AD_PROVIDER="google"

NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID="ca-pub-xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_FEED_TOP="1000001"
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_FEED_MID="1000002"
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_SIDEBAR="1000003"

# Optional: full ads.txt body (multiple lines). If unset, /ads.txt is built from NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID.
# ADS_TXT_CONTENT="google.com, pub-1234567890123456, DIRECT, f08c47fec0942fa0"

# Direct sponsor mode: set NEXT_PUBLIC_AD_PROVIDER="direct" and fill image + URL (slots ignored).
NEXT_PUBLIC_DIRECT_AD_TITLE="Piblisite"
NEXT_PUBLIC_DIRECT_AD_IMAGE_URL="https://via.placeholder.com/1200x628.png?text=Your+Ad+Here"
NEXT_PUBLIC_DIRECT_AD_TARGET_URL="https://zenlakay.com"
NEXT_PUBLIC_DIRECT_AD_DESCRIPTION="Mete anons ou isit pou rive sou kominote ayisyen an."
NEXT_PUBLIC_CONTACT_EMAIL="hello@zenlakay.com"
